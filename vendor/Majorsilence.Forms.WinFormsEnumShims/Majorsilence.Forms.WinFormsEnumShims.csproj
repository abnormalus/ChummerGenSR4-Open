<Project Sdk="Microsoft.NET.Sdk">

  

  <PropertyGroup>
    
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    
    <AssemblyName>System.Windows.Forms</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Majorsilence.Forms.WinFormsEnumShims</PackageId>
    <Description>Internal support package for Majorsilence.Forms: stand-in enum types used to read WinForms-typed .resx entries (Dock, Anchor) cross-platform. Not meant to be referenced directly.</Description>
    <PackageTags>Majorsilence;Forms;Winforms;Migration;Internal</PackageTags>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

<PropertyGroup><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>26.11.4</Version><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup></Project>