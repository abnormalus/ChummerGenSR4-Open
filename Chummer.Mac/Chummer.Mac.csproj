<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ChummerMac</AssemblyName>
    <RootNamespace>Chummer</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ChummerReleaseVersion Condition="'$(ChummerReleaseVersion)' == ''">0.2.0-development</ChummerReleaseVersion>
    <ChummerFileVersion Condition="'$(ChummerFileVersion)' == ''">0.2.0.0</ChummerFileVersion>
    <ApplicationIcon>branding/chummer.ico</ApplicationIcon>
    <ApplicationManifest>../packaging/windows/app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    
    <!-- The application is warning-clean. Compatibility sources have a separate debt policy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../vendor/Majorsilence.Forms/Majorsilence.Forms.csproj" />
    <ProjectReference Include="../vendor/Majorsilence.Forms.Avalonia/Majorsilence.Forms.Avalonia.csproj" />
    <PackageReference Include="Majorsilence.Forms.Headless" Version="26.11.4" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets/data/**" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/export/**" Link="export/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/lang/**" Link="lang/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/sheets/**" Link="sheets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/settings/**" Link="settings/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../changelog.txt" Link="changelog.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="pdfjs/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="branding/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icons/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
  </ItemGroup>
  <!-- Generate only reporting attributes; retain the legacy assembly identity. -->
  <Target Name="GenerateChummerBuildIdentity" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ChummerIdentityAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(ChummerReleaseVersion)</_Parameter1>
      </ChummerIdentityAttribute>
      <ChummerIdentityAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(ChummerFileVersion)</_Parameter1>
      </ChummerIdentityAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)ChummerBuildIdentity.g.cs" AssemblyAttributes="@(ChummerIdentityAttribute)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>
</Project>